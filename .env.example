# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Public Key (from Discord Developer Portal -> General Information)
DISCORD_PUBLIC_KEY=your_public_key_here

# Port for the webhook server (default: 3000)
PORT=3000

# Admin credentials for the web interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Discord IDs for the verification message
VERIFY_CHANNEL_ID=1466797134580941024
VERIFY_MESSAGE_ID=1467907518440276028
